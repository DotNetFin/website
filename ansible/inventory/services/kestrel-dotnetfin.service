[Unit]
Description=DotNetFin website Application

[Service]
WorkingDirectory=/var/www/DotNetFin
ExecStart=/var/www/DotNetFin/website
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnetfin-website
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=DOTNETFIN_SENDGRID_KEY="place-for-key"

[Install]
WantedBy=multi-user.target